DATABASE_URL=postgresql://store:store@localhost:5544/store
# Name recorded in the audit log for calls made through the MCP server.
AGENT_ID=claude-agent
# Key the approvals API expects in the X-API-Key header. Change it outside local dev.
APPROVER_API_KEY=dev-approver-key
# fastembed (local model, no API key) or fake (deterministic, for tests).
EMBEDDER=fastembed
# A price change larger than this fraction of the current price is flagged high risk.
HIGH_RISK_THRESHOLD=0.30
